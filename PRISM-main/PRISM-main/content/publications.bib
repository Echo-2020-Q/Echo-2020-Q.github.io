@misc{qin2026exploringcooperationmechanismsreinforcement,
  selected={true},
  title = {Exploring cooperation mechanisms via reinforcement learning in network common-pool resource games},
  author={Yihang Qin and Lin Wang},
  year = {2026},
  eprint={2606.05867},
  archivePrefix={arXiv},
  primaryClass={cs.GT},
  url={https://arxiv.org/abs/2606.05867}, 
  description={Used GNN-based reinforcement learning agent to design adaptive allocation mechanisms for sustaining cooperation in network common-pool resource games.},

  keywords={Reinforcement Learning, Cooperation, Common-Pool Resource Games, Multi-Agent Systems},
  presentation_images = {commonpool26/editable_model_diagram_1.png, commonpool26/editable_model_diagram_2.png, commonpool26/editable_model_diagram_3.png},

  presentation_titles = {
    Overview of the network common-pool resource game. ||
    Proposed GNN-based reinforcement learning framework. ||
    Evaluation metrics over time in four topologies under different allocation mechanisms.
  },

  presentation_captions = {
  This work studies how reinforcement learning can be used to promote cooperation in networked common-pool resource games. I developed a resource-constrained evolutionary game model, designed a learnable allocation mechanism, and compared the learned policy with classical allocation rules. The results show that adaptive resource allocation can improve cooperation, reduce resource inequality, and enhance the sustainability of the system. ||

  The agent observes global features $u$, node features $V$, and edge features $E$ from the game state. 
    The Actor first encodes the graph with a two-layer GraphNet backbone, then applies a shared ego-network allocation head to each focal node. 
    For a focal node $i$, its ego-network is processed by a local GraphNet and a score MLP; a softmax over the candidate nodes produces a row-wise allocation distribution for the resource pool associated with node $i$. 
    The row-wise allocations are assembled into the final resource allocation action $A$.  ||
    
  I employ a mixture allocation mechanism (M2) based on a baseline allocation approach to fit and interpret the allocation strategy learned by the RL-Agent, achieving better performance of cooperation frequency, accumulated resource and Gini index in longer episodes and different network structures.
  }
}




@article{qin2026recovering,
  selected={true},
  title = {Recovering cooperation in Spatial Prisoner’s Dilemma via a forced loner mechanism},
  author={Qin, Yihang and Chen, Hao and Wang, Lin},
  journal = {Physica A: Statistical Mechanics and its Applications},
  pages={131309},
  year = {2026},
  publisher={Elsevier},
  doi = {10.1016/j.physa.2026.131309},
  langid = {english},
  description={Inspired by social welfare safety nets, this work develops a Forced Loner Mechanism to recover cooperation and improve efficiency, sustainability, and fairness in resource-constrained spatial Prisoner’s Dilemma games.},
  keywords={Evolutionary Game Theory, Cooperation, Spatial Prisoner's Dilemma, Complex Systems},
  presentation_images = {forceloner26/Figure1.png, forceloner26/Figure2.png, forceloner26/Figure3.png, forceloner26/Figure4.png, forceloner26/Figure5.png},

  presentation_titles = {
    Forced Loner Mechanism (FLM) overview.||
    Forced loners recover cooperation under strong temptation. ||
    Spatial snapshots of strategy evolution.||
    Forced loners suppress persistent defector clusters.||
    Forced loners avoid loner dominance.
  },
  
  presentation_captions = {
  In this work, I study how a forced exit-and-support mechanism can recover cooperation in a resource-constrained Spatial Prisoner’s Dilemma. When agents become bankrupt, they are forced to become loners and receive a small subsistence payoff, representing social subsidies or institutional safety nets. The results show that this mechanism can suppress defector dominance, restore cooperation, and improve system-level efficiency, sustainability, and fairness. ||

  When the temptation to defect (b) becomes high, the forced loner mechanism restores cooperation and improves system-level performance. Compared with the no-loner baseline, it increases net output, which means that even if the government or the social planner bears the cost of maintaining basic subsidies for bankrupts, the net output of the game system is still higher compared to the situation without bankruptcy protection, and accumulated resources while reducing inequality. ||
    
  To Understand how the forced loner mechanism operates at the micro level, I take snapshots of the evolutionary process. Without forced loners, defector clusters tend to persist and dominate the lattice. With the forced loner mechanism, bankrupt agents emerge inside defector clusters, once interact with cooperators, they disrupt their spatial structure, and create opportunities for cooperators to regrow. ||

  To understand how the forced loner mechanism operates at the macro level, I use the methods of statistical physics. The forced loner mechanism reduces both the size and lifetime of defector clusters. This shows that FLM not only changes aggregate cooperation levels, but also weakens the spatial and temporal stability of defection. ||

  Unlike voluntary loners, which can dominate the system under strong temptation to defect, the forced loner mechanism maintains a coexistence of cooperators, defectors, and loners. This suggests that institutionally triggered exit can stabilize cooperation without turning withdrawal into the dominant strategy. Similarly, this reveals that when societal challenges are significant or awkward, relying solely on spontaneous market adjustments within the system often makes it difficult to sustain cooperation; in such cases, external intervention by the government or social planners can be particularly effective.
  
  }
}

@article{qin2026tripartite,
  title={A tripartite intervention--conflict game with Frequency-Adjusted Q-learning},
  author={Qin, Yihang and Chen, Hao and Wang, Lin},
  pages={117072},
  year={2026},
  publisher={Elsevier},
  doi = {10.1016/j.apm.2026.117072},
  langid = {english},
  description={Linked frequency-adjusted Q-learning with evolutionary game analysis in a tripartite intervention–conflict framework.},
  keywords={Q-learning, Reinforcement Learning, Evolutionary Game Theory, Strategic Interaction},
  presentation_images = {faq_learning26/Figure1.png, faq_learning26/Figure2.png, faq_learning26/Figure3.png, faq_learning26/Figure4.png},

  presentation_titles = {
    Tripartite relationship diagram illustrating the Intervener-Challenger-Victim (ICV) game structure. ||
    Schematic illustration of the evolutionary analysis procedure for the FAQ-learning dynamics. ||
    The dynamic-error analysis on evolution.||
    Evolution trajectories under discrete FAQ-learning algorithms, FAQ-learning dynamics and replicator dynamics are
shown.
  },
  
  presentation_captions = {
  In this project, I study how boundedly rational actors learn and adapt in tripartite conflict–intervention scenarios. I propose an Intervener–Challenger–Victim game framework and use Frequency-Adjusted Q-learning to connect reinforcement learning dynamics with evolutionary game analysis, where a third party can either provide direct assistance or adopt an indirect strategy to influence the interaction between a challenger and a victim. ||

  Frequency-Adjusted Q-learning is transformed into continuous evolutionary dynamics. Therefore, we can use evolutionary game theory to analyze the long-term behavior of the learning agents, where three partition surfaces divide the strategy space and reveal how the three actors move toward different stable outcomes. ||
    
  This figure evaluates how accurately the evolutionary-game partition surfaces approximate the true FAQ-learning dynamics. Most regions exhibit small errors, validating the analytical bridge between reinforcement learning and evolutionary dynamics.||

  This figure further validates the analytical bridge between reinforcement learning and evolutionary game dynamics. The discrete FAQ-learning process shows short-term fluctuations, but its long-term convergence is well captured by the continuous FAQ-learning dynamics and replicator dynamics.

  }
}

